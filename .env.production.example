# Production configuration. Copy to .env on the server and fill in. Never commit .env.
#
# Standalone on purpose: this file is not a diff against `.env.example`, so there is no
# way to deploy by copying the local file and forgetting a line. Notably AUTH_DEV_MODE
# does not appear here at all — /api/auth/dev-login must never be reachable in production.

APP_ENV=production
# Both must be the real public origin: the OAuth discovery documents, the Google redirect
# URI and the MCP connector metadata are all derived from them.
APP_URL=https://sightread.example.com
WEB_URL=https://sightread.example.com

# Keep the password here identical to POSTGRES_PASSWORD below.
DATABASE_URL=postgresql+asyncpg://sightread:<generate-a-password>@pg:5432/sightread
POSTGRES_USER=sightread
# No default in docker-compose.production.yaml — the stack refuses to start without it.
POSTGRES_PASSWORD=<generate-a-password>
POSTGRES_DB=sightread

# Sessions + HKDF root for OpenRouter-key encryption. Generate fresh per environment:
#   openssl rand -hex 32
# Never reuse the local value. Once users exist this is effectively permanent: rotating it
# invalidates every session and makes stored OpenRouter keys undecryptable.
SECRET_KEY=<generate-a-long-random-string>

# Google OIDC — required, there is no dev-login fallback here. The OAuth client needs
# https://<domain>/api/auth/callback as an authorized redirect URI and https://<domain>
# as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

# The host Caddy serves and gets a certificate for, and where Let's Encrypt sends expiry
# notices. DOMAIN normally matches APP_URL/WEB_URL without the scheme.
DOMAIN=sightread.example.com
ACME_EMAIL=you@example.com

# Limits (defaults shown; see docs/api.md, docs/jobs.md)
# UPLOAD_MAX_BYTES is enforced twice: here while streaming, and by request_body in
# deploy/caddy/Caddyfile. Change both together.
UPLOAD_MAX_BYTES=134217728
PAGE_CAP=500
MAX_JOBS_PER_USER=2
VISION_CONCURRENCY_PER_JOB=8
# RENDER_WORKERS defaults to CPU count
UPLOAD_DIR=/data/uploads
