# Copy to .env and fill in. Never commit .env.

APP_ENV=local
APP_URL=http://localhost:8000
WEB_URL=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://sightread:sightread@pg:5432/sightread
POSTGRES_USER=sightread
POSTGRES_PASSWORD=sightread
POSTGRES_DB=sightread
# Host port the local compose stack publishes PostgreSQL on; change it when 5432 is
# already in use on this machine (the container still listens on 5432 internally).
PG_PORT=5432

# Long random string; sessions + HKDF root for OpenRouter-key encryption.
SECRET_KEY=<generate-a-long-random-string>

# Google OIDC (required in production; optional locally with AUTH_DEV_MODE)
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

# Local only — enables /api/auth/dev-login. Ignored unless APP_ENV=local.
AUTH_DEV_MODE=true

# Limits (defaults shown; see docs/api.md, docs/jobs.md)
UPLOAD_MAX_BYTES=134217728
PAGE_CAP=500
MAX_JOBS_PER_USER=2
VISION_CONCURRENCY_PER_JOB=8
# RENDER_WORKERS defaults to CPU count
UPLOAD_DIR=/data/uploads

# --- Production only (docker-compose.production.yaml) ---
# Set APP_ENV=production, remove AUTH_DEV_MODE, point APP_URL and WEB_URL at https://<domain>,
# and give POSTGRES_PASSWORD a real value — the production stack has no default for it.
# DOMAIN is the host Caddy serves and gets a certificate for; ACME_EMAIL is where Let's
# Encrypt sends expiry notices. Database dumps land in ./backups next to the compose file.
# DOMAIN=sightread.example.com
# ACME_EMAIL=you@example.com
